{
  "name": "@snorna/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx src/seed.ts",
    "import:all": "tsx src/import-all.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "csv-parse": "^5.5.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "prisma": "^6.7.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3"
  }
}
