{
  "name": "snorna-database",
  "version": "1.0.0",
  "description": "snoRNA-BIU biological database monorepo",
  "scripts": {
    "dev": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w packages/db",
    "db:migrate": "npm run db:migrate -w packages/db",
    "db:seed": "npm run db:seed -w packages/db",
    "import:data": "npm run import:all -w packages/db"
  },
  "keywords": [
    "snorna",
    "bioinformatics",
    "database"
  ],
  "author": "snoRNA-BIU",
  "license": "ISC",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
