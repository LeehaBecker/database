FROM node:20-bookworm-slim
WORKDIR /app

# BLAST+ for /tools/blast/run (makeblastdb, blastn)
RUN apt-get update \
  && apt-get install -y --no-install-recommends ncbi-blast+ \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci
COPY . .
RUN npm run db:generate -w packages/db && npm run build -w packages/shared && npm run build -w packages/db && npm run build -w apps/api
CMD ["npm", "run", "start", "-w", "apps/api"]
